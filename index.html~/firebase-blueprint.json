{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with privacy-first settings.",
      "type": "object",
      "properties": {
        "isAnonymous": { "type": "boolean" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lang": { "type": "string", "description": "Preferred language (en/fr/pidgin)" }
      },
      "required": ["isAnonymous", "createdAt"]
    },
    "Mood": {
      "title": "Mood",
      "description": "Daily mood check-in entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "score": { "type": "integer", "description": "1 to 5 scale" },
        "note": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "score", "timestamp"]
    },
    "Journal": {
      "title": "Journal",
      "description": "Private journal entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "timestamp"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "moods/{moodId}": {
      "schema": "Mood",
      "description": "Mood tracking records"
    },
    "journals/{journalId}": {
      "schema": "Journal",
      "description": "Journal entries"
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Chat history"
    }
  }
}
